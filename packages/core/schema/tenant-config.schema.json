{
  "$comment": "AUTO-GERADO por scripts/gen-json-schema.mjs — não editar à mão. Rode `pnpm --filter @yukilabs/agnostic-ui-core gen:schema`.",
  "$ref": "#/definitions/TenantConfig",
  "definitions": {
    "TenantConfig": {
