{
  "kind": "template",
  "name": "empty-state",
  "specVersion": "1.0",
  "description": "Binding nas props de um componente especializado (empty-state).",
  "template": {
    "type": "empty-state",
    "props": { "title": "Sem itens", "message": "{{ msg }}" }
  },
  "context": { "msg": "Adicione um produto" },
  "expected": {
    "type": "empty-state",
    "props": { "title": "Sem itens", "message": "Adicione um produto" }
  }
}
