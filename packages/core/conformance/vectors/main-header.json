{
  "name": "main-header",
  "specVersion": "1.0",
  "description": "Binding nas props de um header do catálogo (família Headers).",
  "template": {
    "type": "main-header",
    "props": { "title": "Olá, {{ user.name }}", "subtitle": "bem-vindo" }
  },
  "context": { "user": { "name": "Ada" } },
  "expected": {
    "type": "main-header",
    "props": { "title": "Olá, Ada", "subtitle": "bem-vindo" }
  }
}
