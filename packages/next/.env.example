# Variáveis do BFF. Copie para .env.local OU rode `pnpm setup:local` (gera o arquivo).
# .env.local é ignorado pelo git; nunca commite segredos (ADR 0003).

# Config store (ADR 0002 §4). Em local é gerado por setup:local a partir do supabase status.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55422/postgres"

# Supabase local (ADR 0003) — portas 554xx para não colidir com outros projetos.
SUPABASE_URL="http://127.0.0.1:55421"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Hardening JWT (ADR 0001) — obrigatório em produção live (JWT_JWKS_URL OU JWT_HS256_SECRET).
JWT_HS256_SECRET=""
# JWT_JWKS_URL=""

# Authz do builder (ADR 0004 §3) — opt-in: sem chave, a API /api/builder/* nega tudo
# (fail-closed). Verifica o access-token do Supabase Auth (JWKS OU o segredo HS256).
# SUPABASE_JWT_JWKS_URL=""
SUPABASE_JWT_SECRET=""

# Rate limit opcional (ADR 0001).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Allowlist de egress dos conectores (ADR 0003) — hosts liberados, separados por vírgula.
EGRESS_ALLOWLIST=""

# IA-como-editor (ADR 0006, Frente I) — opcional. Sem a chave, a IA fica indisponível
# (a pipeline trata como 503; o builder visual/manual segue normal).
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-4-6"
