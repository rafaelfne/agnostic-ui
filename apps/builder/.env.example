# Variáveis do builder SPA (Vite). Copie para .env.local (gitignored). NUNCA segredos:
# a anon key do Supabase é pública por design; o service_role JAMAIS vai para o cliente.

# Supabase Auth (login). Em local, valores vêm de `supabase status` (ADR 0003).
VITE_SUPABASE_URL="http://127.0.0.1:55421"
VITE_SUPABASE_ANON_KEY=""

# Base da API do builder. Vazio = mesma origem (dev usa o proxy /api do Vite).
VITE_API_BASE=""
