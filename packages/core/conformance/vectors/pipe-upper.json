{
  "kind": "template",
  "name": "pipe-upper",
  "specVersion": "1.0",
  "description": "Pipe para função curada (sem locale, determinístico).",
  "template": {
    "type": "text",
    "props": { "value": "{{ user.name | upper }}" }
  },
  "context": { "user": { "name": "Ada" } },
  "expected": {
    "type": "text",
    "props": { "value": "ADA" }
  }
}
