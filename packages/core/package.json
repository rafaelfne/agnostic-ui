{
  "name": "@yukilabs/agnostic-ui-core",
  "version": "0.0.0",
  "description": "Shared kernel for Agnostic UI: bridge protocol, sandbox markers, JWT decoding, and Zod schemas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafaelfne/agnostic-ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:schema": "node scripts/gen-json-schema.mjs",
    "gen:schema:check": "node scripts/gen-json-schema.mjs --check"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
