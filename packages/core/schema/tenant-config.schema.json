          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "properties": {
            "header": {
              "type": "object",
              "properties": {
                "showLogo": {
                  "type": "boolean"
                },
                "showTitle": {
                  "type": "boolean"
                },
                "title": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "appBar": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "object",
                  "properties": {
                    "sticky": {
                      "type": "boolean"
                    },
                    "frosted": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "routes": {
                  "type": "object",
