{
  "kind": "template",
  "name": "nested-children",
  "specVersion": "1.0",
  "description": "Recursão pela árvore: binding resolve dentro de children.",
  "template": {
    "type": "card",
    "children": [
      { "type": "heading", "props": { "text": "{{ title }}" } },
      { "type": "text", "props": { "value": "{{ body }}" } }
    ]
  },
  "context": { "title": "Saldo", "body": "Disponível" },
  "expected": {
    "type": "card",
    "children": [
      { "type": "heading", "props": { "text": "Saldo" } },
      { "type": "text", "props": { "value": "Disponível" } }
    ]
  }
}
